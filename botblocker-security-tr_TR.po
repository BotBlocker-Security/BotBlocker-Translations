msgstr "Çağrıdan önceki güvenli kip."

#: includes/inc-botblocker-wp-abilities.php:581
msgid "Requested secure mode."
msgstr "İstenen güvenli kip."

#: includes/inc-botblocker-wp-abilities.php:572
