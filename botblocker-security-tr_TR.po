#: includes/utilites/class-botblocker-deactivation-feedback.php:234
msgid "Moving to another plugin"
msgstr "Başka bir eklentiye geçiyorum"

#: includes/utilites/class-botblocker-deactivation-feedback.php:233
msgid "Malware scanning"
msgstr "Kötü amaçlı yazılım taraması"

#: includes/utilites/class-botblocker-deactivation-feedback.php:232
msgid "Spam or form protection"
msgstr "İstenmeyen veya form koruması"

#: includes/utilites/class-botblocker-deactivation-feedback.php:230
msgid "Could not find a setting"
msgstr "Bir ayar bulunamadı"

#: includes/utilites/class-botblocker-deactivation-feedback.php:229
msgid "Not sure which settings to choose"
msgstr "Hangi ayarları seçeceğimden emin değilim"

#: includes/utilites/class-botblocker-deactivation-feedback.php:228
msgid "Too many settings"
msgstr "Çok fazla ayar"

#: includes/utilites/class-botblocker-deactivation-feedback.php:227
msgid "Mostly on phones"
msgstr "Çoğunlukla telefonlarda"

#: includes/utilites/class-botblocker-deactivation-feedback.php:226
msgid "Every time they come back"
msgstr "Her geri döndüklerinde"

#: includes/utilites/class-botblocker-deactivation-feedback.php:225
msgid "Search engines or other good bots"
msgstr "Arama motorları veya diğer iyi botlar"

#: includes/utilites/class-botblocker-deactivation-feedback.php:223
msgid "Site got slower"
msgstr "Site yavaşladı"

#: includes/utilites/class-botblocker-deactivation-feedback.php:222
msgid "Another plugin, theme or integration broke"
msgstr "Başka bir eklenti, tema veya bütünleştirme bozuldu"

#: includes/utilites/class-botblocker-deactivation-feedback.php:221
msgid "Admins could not log in"
msgstr "Yöneticiler oturum açamadı"

#: includes/utilites/class-botblocker-deactivation-feedback.php:213
msgid "What were you looking for?"
msgstr "Ne arıyordunuz?"

#: includes/utilites/class-botblocker-deactivation-feedback.php:212
msgid "What was hard?"
msgstr "Neyi zor buldunuz?"

#: includes/utilites/class-botblocker-deactivation-feedback.php:211
msgid "When do they see it?"
msgstr "Bunu ne zaman görüyorlar?"

#: includes/utilites/class-botblocker-deactivation-feedback.php:210
msgid "Who could not get in?"
msgstr "Kimler giremedi?"

#: includes/utilites/class-botblocker-deactivation-feedback.php:201
msgid "It does not do what I need"
msgstr "İhtiyacım olanı yapmıyor"

#: includes/utilites/class-botblocker-deactivation-feedback.php:199
msgid "Visitors get in, but are asked to verify too often"
msgstr "Ziyaretçiler girebiliyor ancak çok sık doğrulama isteniyor"

#: includes/utilites/class-botblocker-deactivation-feedback.php:198
msgid "Real visitors could not get into the site"
msgstr "Gerçek ziyaretçiler siteye giremedi"

#: includes/utilites/class-botblocker-deactivation-feedback.php:197
msgid "Something broke or slowed my site down"
msgstr "Bir şey bozuldu veya sitemi yavaşlattı"

#: includes/utilites/class-botblocker-deactivation-feedback.php:110
msgid "What were you missing, or which plugin are you switching to?"
msgstr "Neyi eksik buldunuz veya hangi eklentiye geçiyorsunuz?"

#: includes/pro/class-botblocker-settings-presets.php:990
msgid "Temporary: very strict rate limits, VPN/Tor/hosting blocks and server DDoS resilience. Re-apply Strong after the attack."
msgstr "Geçici: çok sıkı hız sınırları, VPN/Tor/barındırma engelleri ve sunucu DDoS dayanıklılığı. Saldırıdan sonra Güçlü düzeyini yeniden uygulayın."

#: includes/pro/class-botblocker-settings-presets.php:987
msgid "Emergency"
msgstr "Acil durum"

#: includes/pro/class-botblocker-settings-presets.php:984
msgid "Allows empty Accept-Language for API clients and automation; keep an allowlist for admin/MCP IPs."
msgstr "API istemcileri ve otomasyon için boş Accept-Language değerine izin verir; yönetici/MCP IP adresleri için bir izin listesi tutun."

#: includes/pro/class-botblocker-settings-presets.php:982
msgid "Strong API"
msgstr "Güçlü API"

#: includes/pro/class-botblocker-settings-presets.php:978
#: includes/pro/class-botblocker-settings-presets.php:991
msgid "Requires Accept-Language from clients unless allowlisted."
msgstr "İzin listesinde yer almıyorsa istemcilerden Accept-Language ister."

#: includes/pro/class-botblocker-settings-presets.php:977
msgid "Blocks private browsing, VPN, Tor and hosting traffic; keep an exclusion list."
msgstr "Kişisel tarama, VPN, Tor ve barındırma trafiğini engeller; bir hariç tutma listesi tutun."

#: includes/pro/class-botblocker-settings-presets.php:971
msgid "Requires Accept-Language from clients; API clients without it get blocked unless allowlisted."
msgstr "İstemcilerden Accept-Language ister; bunu göndermeyen API istemcileri izin listesinde yer almıyorsa engellenir."

#: includes/pro/class-botblocker-settings-presets.php:966
msgid "Adds fake-referrer, referrer and honeypot checks on top of Balanced; does not block ad blockers, Cloudflare or classic proxies."
msgstr "Dengeli düzeyinin üzerine sahte yönlendiren, yönlendiren ve bal küpü denetimleri ekler; reklam engelleyicileri, Cloudflare veya klasik vekil sunucuları engellemez."

#: includes/pro/class-botblocker-settings-presets.php:964
msgid "Medium"
msgstr "Orta"

#: includes/modal/modal-botblocker-proxy-add.php:59
#: includes/modal/modal-botblocker-proxy-edit.php:60
msgid "Crawler network"
msgstr "Tarayıcı bot ağı"

#: includes/modal/modal-botblocker-proxy-add.php:58
#: includes/modal/modal-botblocker-proxy-edit.php:59
msgid "Site edge"
msgstr "Site uç sunucusu"

#: includes/modal/modal-botblocker-proxy-add.php:54
#: includes/modal/modal-botblocker-proxy-edit.php:55
msgid "Site edge trusts the forwarding header. Crawler network keeps the peer address and never trusts the header."
msgstr "Site uç sunucusu iletme üst bilgisine güvenir. Tarayıcı bot ağı eş adresini korur ve üst bilgiye asla güvenmez."

#: includes/inc-botblocker-wp-abilities.php:2969
msgid "This rule id exists in both address families. Pass family ipv4 or ipv6."
msgstr "Bu kural kimliği her iki adres ailesinde de mevcut. Aile olarak ipv4 veya ipv6 belirtin."

#: includes/inc-botblocker-wp-abilities.php:2962
msgid "The family must be ipv4 or ipv6."
msgstr "Adres ailesi ipv4 veya ipv6 olmalıdır."

#: includes/inc-botblocker-wp-abilities.php:1306
msgid "Rows aggregated under this key."
msgstr "Bu anahtar altında toplanan satırlar."

#: includes/inc-botblocker-wp-abilities.php:1305
msgid "Aggregated value: country code, ASN, user-agent family, status or path."
msgstr "Toplanmış değer: ülke kodu, ASN, user-agent ailesi, durum veya yol."

#: includes/inc-botblocker-wp-abilities.php:1294
msgid "Failed logins recorded for the user in the last 30 days."
msgstr "Son 30 günde kullanıcı için kaydedilen başarısız girişler."

#: includes/inc-botblocker-wp-abilities.php:1293
msgid "True when a secret exists without _2fa_verified, or when _2fa_secret_temp exists."
msgstr "_2fa_verified olmadan bir gizli anahtar varsa veya _2fa_secret_temp varsa doğru."

#: includes/inc-botblocker-wp-abilities.php:1292
msgid "True when _2fa_secret and _2fa_verified are both present."
msgstr "_2fa_secret ve _2fa_verified her ikisi de mevcut olduğunda doğru."

#: includes/inc-botblocker-wp-abilities.php:1291
msgid "Registration date, ISO 8601."
msgstr "Kayıt tarihi, ISO 8601."

#: includes/inc-botblocker-wp-abilities.php:1290
msgid "Role slugs assigned to the user."
msgstr ""

#: includes/inc-botblocker-wp-abilities.php:1289
msgid "User email, masked."
msgstr "Kullanıcı e-postası, maskelenmiş."

#: includes/inc-botblocker-wp-abilities.php:1288
msgid "User login, masked."
msgstr "Kullanıcı girişi, maskelenmiş."

#: includes/inc-botblocker-wp-abilities.php:1287
msgid "WordPress user id."
msgstr "WordPress kullanıcı kimliği."

#: includes/inc-botblocker-wp-abilities.php:1190
msgid "Human-readable CAPTCHA mode label; do not parse."
msgstr "İnsan tarafından okunabilen CAPTCHA kip etiketi; ayrıştırmayın."

#: includes/inc-botblocker-wp-abilities.php:1188
msgid "Human-readable secure mode label; do not parse."
msgstr "İnsan tarafından okunabilen güvenli kip etiketi; ayrıştırmayın."

#: includes/inc-botblocker-wp-abilities.php:1187
msgid "Secure mode: 0 when settings are unavailable, 1 frontend, 2 full."
msgstr "Güvenli kip: ayarlar kullanılamıyorsa 0, 1 ara yüz, 2 tam."

#: includes/inc-botblocker-wp-abilities.php:1176
msgid "Last attempt time as a Unix timestamp."
msgstr "Son deneme zamanı Unix zaman damgası olarak."

#: includes/inc-botblocker-wp-abilities.php:1175
msgid "Last sync time as a Unix timestamp."
msgstr "Son eşitleme zamanı Unix zaman damgası olarak."

#: includes/inc-botblocker-wp-abilities.php:1174
msgid "Number of TLS fingerprints in the local database."
msgstr "Yerel veritabanındaki TLS parmak izi sayısı."

#: includes/inc-botblocker-wp-abilities.php:1173
msgid "Number of ranges in the local database."
msgstr "Yerel veritabanındaki aralık sayısı."

#: includes/inc-botblocker-wp-abilities.php:1172
msgid "Number of providers in the local database."
msgstr "Yerel veritabanındaki sağlayıcı sayısı."

#: includes/inc-botblocker-wp-abilities.php:1171
msgid "Generation time as a Unix timestamp."
msgstr "Oluşturma zamanı Unix zaman damgası olarak."

#: includes/inc-botblocker-wp-abilities.php:1170
msgid "Stored data hash."
msgstr "Saklanan veri karması."

#: includes/inc-botblocker-wp-abilities.php:1169
msgid "Last failure reason code."
msgstr "Son hata neden kodu."

#: includes/inc-botblocker-wp-abilities.php:1168
msgid "Consecutive failure count."
msgstr "Ardışık başarısızlık sayısı."

#: includes/inc-botblocker-wp-abilities.php:1167
msgid "Source URL used for the download."
msgstr "İndirme için kullanılan kaynak adres."

#: includes/inc-botblocker-wp-abilities.php:1166
msgid "Last error text; empty when the last attempt succeeded."
msgstr "Son hata metni; son deneme başarılı olduğunda boş."

#: includes/inc-botblocker-wp-abilities.php:1165
msgid "Last update attempt as a Unix timestamp."
msgstr "Son güncelleme denemesi Unix zaman damgası olarak."

#: includes/inc-botblocker-wp-abilities.php:1164
msgid "Download time as a Unix timestamp; 0 when never downloaded."
msgstr "İndirme zamanı Unix zaman damgası olarak; hiç indirilmediyse 0."

#: includes/inc-botblocker-wp-abilities.php:1163
msgid "Downloaded size in bytes."
msgstr "İndirilen boyut (bayt)."

#: includes/inc-botblocker-wp-abilities.php:1162
msgid "SHA-256 of the downloaded data."
msgstr "İndirilen verinin SHA-256 değeri."

#: includes/inc-botblocker-wp-abilities.php:1161
msgid "Number of nodes in the threat database."
msgstr "Tehdit veritabanındaki düğüm sayısı."

#: includes/inc-botblocker-wp-abilities.php:1160
msgid "Build time as a Unix timestamp."
msgstr "Unix zaman damgası olarak derleme zamanı."

#: includes/inc-botblocker-wp-abilities.php:1159
msgid "Database type reported by the source."
msgstr "Kaynak tarafından bildirilen veritabanı türü."

#: includes/inc-botblocker-wp-abilities.php:1158
msgid "Threat data version."
msgstr "Tehdit verisi sürümü."

#: includes/inc-botblocker-wp-abilities.php:1157
msgid "Source state code."
msgstr "Kaynak durum kodu."

#: includes/inc-botblocker-wp-abilities.php:1146
msgid "Always true; masking is always applied and cannot be disabled."
msgstr "Her zaman doğru; maskeleme her zaman uygulanır ve etkisizleştirilemez."

#: includes/inc-botblocker-wp-abilities.php:1144
msgid "Actor user id; 0 when unknown."
msgstr "Aktör kullanıcı kimliği; bilinmediğinde 0."

#: includes/inc-botblocker-wp-abilities.php:1143
msgid "Call duration in milliseconds."
msgstr "Çağrı süresi milisaniye cinsinden."

#: includes/inc-botblocker-wp-abilities.php:1142
msgid "Error code; empty on success."
msgstr "Hata kodu; başarılı olduğunda boş."

#: includes/inc-botblocker-wp-abilities.php:1141
msgid "Call outcome."
msgstr "Çağrı sonucu."

#: includes/inc-botblocker-wp-abilities.php:1140
msgid "Ability name."
msgstr "Yetkinlik adı."

#: includes/inc-botblocker-wp-abilities.php:1138
msgid "Call log row id."
msgstr "Çağrı günlüğü satırı kimliği."

#: includes/inc-botblocker-wp-abilities.php:1126
msgid "Trace generation duration in seconds, as stored."
msgstr "İz oluşturma süresi, saniye cinsinden, kaydedildiği şekilde."

#: includes/inc-botblocker-wp-abilities.php:1112
msgid "Requests per minute for this address."
msgstr "Bu adres için dakika başına istek sayısı."

#: includes/inc-botblocker-wp-abilities.php:1100
msgid "Proxy signal text."
msgstr "Proxy sinyali metni."

#: includes/inc-botblocker-wp-abilities.php:1099
msgid "Geo signal text."
msgstr "Coğrafi sinyal metni."

#: includes/inc-botblocker-wp-abilities.php:1098
msgid "Human-readable decision reason, truncated to 80 characters because it may contain a PTR."
msgstr "İnsan tarafından okunabilen karar gerekçesi, PTR içerebileceği için 80 karaktere kısaltıldı."

#: includes/inc-botblocker-wp-abilities.php:1086
msgid "Address subject source."
msgstr "Adres özne kaynağı."

#: includes/inc-botblocker-wp-abilities.php:1085
msgid "Edge header name."
msgstr "Kenar üst bilgisi adı."

#: includes/inc-botblocker-wp-abilities.php:1084
msgid "Edge state code."
msgstr "Kenar durum kodu."

#: includes/inc-botblocker-wp-abilities.php:1083
msgid "Edge role code."
msgstr "Kenar rol kodu."

#: includes/inc-botblocker-wp-abilities.php:1082
msgid "Client address, masked."
msgstr "İstemci adresi, maskelenmiş."

#: includes/inc-botblocker-wp-abilities.php:1081
msgid "Peer address, masked."
msgstr "Eş adresi, maskelenmiş."

#: includes/inc-botblocker-wp-abilities.php:1070
msgid "Why the context is uniform or disabled: mu_layer_uniform or headers_disabled."
msgstr "Bağlamın neden tekdüze veya etkisizleştirilmiş olduğu: mu_layer_uniform veya headers_disabled."

#: includes/inc-botblocker-wp-abilities.php:1069
msgid "Whether the add-on sends at least one header in this context."
msgstr "Eklentinin bu bağlamda en az bir üst bilgi gönderip göndermediği."

#: includes/inc-botblocker-wp-abilities.php:1068
msgid "Request context the headers are computed for."
msgstr "Üst bilgilerin hesaplandığı istek bağlamı."

#: includes/inc-botblocker-wp-abilities.php:1057
msgid "Ability names declared by the manifest."
msgstr "Manifest tarafından bildirilen yetkinlik adları."

#: includes/inc-botblocker-wp-abilities.php:1054
msgid "Whether the add-on is compatible with the installed core and PHP."
msgstr "Eklentinin kurulu çekirdek ve PHP ile uyumlu olup olmadığı."

#: includes/inc-botblocker-wp-abilities.php:1039
msgid "Table size in bytes; 0 when unknown."
msgstr "Bayt cinsinden tablo boyutu; bilinmiyorsa 0."

#: includes/inc-botblocker-wp-abilities.php:1038
msgid "Row count; 0 when the table is missing or unknown."
msgstr "Satır sayısı; tablo yoksa veya bilinmiyorsa 0."

#: includes/inc-botblocker-wp-abilities.php:1037
msgid "Whether the table exists."
msgstr "Tablonun var olup olmadığı."

#: includes/inc-botblocker-wp-abilities.php:1036
msgid "Table name without the WordPress prefix, for example bbcs_hits."
msgstr "WordPress ön eki olmadan tablo adı; örneğin bbcs_hits."

#: includes/inc-botblocker-wp-abilities.php:1025
msgid "Cron arguments; present only when args_exposed is true."
msgstr "Cron bağımsız değişkenleri; yalnızca args_exposed true olduğunda bulunur."

#: includes/inc-botblocker-wp-abilities.php:1024
msgid "Schedule interval in seconds; 0 when the event does not recur."
msgstr "Zamanlama aralığı saniye cinsinden; olay yinelenmiyorsa 0."

#: includes/inc-botblocker-wp-abilities.php:1023
msgid "WordPress schedule name; empty when the event does not recur."
msgstr "WordPress zamanlama adı; etkinlik yinelenmediğinde boş."

#: includes/inc-botblocker-wp-abilities.php:1022
msgid "ISO 8601 timestamp of the next run."
msgstr "Sonraki çalışmanın ISO 8601 zaman damgası değeri."

#: includes/inc-botblocker-wp-abilities.php:1021
msgid "Scheduled Unix timestamp."
msgstr "Zamanlanmış Unix zaman damgası."

#: includes/inc-botblocker-wp-abilities.php:1020
msgid "Cron hook name."
msgstr "Cron kancası adı."

#: includes/inc-botblocker-wp-abilities.php:1006
msgid "Whether an X-Forwarded-For header was present; present only when the access payload stores edge data."
msgstr "X-Forwarded-For üst bilgisinin bulunup bulunmadığı; yalnızca erişim yükü uç verileri depoladığında bulunur."

#: includes/inc-botblocker-wp-abilities.php:1005
msgid "Edge client id, masked; present only when the access payload stores edge data."
msgstr "Edge istemci kimliği, maskelenmiş; yalnızca erişim verisi edge verilerini depoladığında bulunur."

#: includes/inc-botblocker-wp-abilities.php:1004
msgid "Edge verification method; present only when the access payload stores edge data."
msgstr "Edge doğrulama yöntemi; yalnızca erişim yükü edge verilerini depoladığında bulunur."

#: includes/inc-botblocker-wp-abilities.php:1003
msgid "Address subject source; present only when the access payload stores edge data."
msgstr "Adres özne kaynağı; yalnızca erişim verisi kenar verilerini depoladığında bulunur."

#: includes/inc-botblocker-wp-abilities.php:1002
msgid "Edge role code; present only when the access payload stores edge data."
msgstr "Edge rol kodu; yalnızca erişim yükü edge verilerini depoladığında bulunur."

#: includes/inc-botblocker-wp-abilities.php:1001
msgid "Edge header name; present only when the access payload stores edge data."
msgstr "Edge üst bilgisi adı; yalnızca erişim yükü edge verilerini depoladığında bulunur."

#: includes/inc-botblocker-wp-abilities.php:1000
msgid "Edge state code; present only when the access payload stores edge data."
msgstr "Edge durum kodu; yalnızca erişim yükü edge verilerini depoladığında bulunur."

#: includes/inc-botblocker-wp-abilities.php:999
msgid "Edge peer address, masked; present only when the access payload stores edge data."
msgstr "Edge eş adresi, maskelenmiş; yalnızca erişim yükü edge verilerini depoladığında bulunur."

#: includes/inc-botblocker-wp-abilities.php:998
msgid "Stored hit counter for the event row."
msgstr "Olay satırı için saklanan isabet sayacı."

#: includes/inc-botblocker-wp-abilities.php:997
msgid "Whether the address belongs to a hosting provider."
msgstr "Adresin bir barındırma hizmeti sağlayıcıya ait olup olmadığı."

#: includes/inc-botblocker-wp-abilities.php:996
msgid "Stored CAPTCHA provider flag."
msgstr "Saklanan CAPTCHA sağlayıcı bayrağı."

#: includes/inc-botblocker-wp-abilities.php:995
msgid "Country name as stored in the event row."
msgstr "Olay satırında saklandığı şekliyle ülke adı."

#: includes/inc-botblocker-wp-abilities.php:991
msgid "Stored VPN flag."
msgstr "Saklanan VPN bayrağı."

#: includes/inc-botblocker-wp-abilities.php:990
msgid "Stored Tor flag."
msgstr "Saklanan Tor bayrağı."

#: includes/inc-botblocker-wp-abilities.php:989
msgid "Stored proxy flag."
msgstr "Saklanan proxy bayrağı."

#: includes/inc-botblocker-wp-abilities.php:988
msgid "Stored pass counter for the request."
msgstr "İstek için saklanan geçiş sayacı."

#: includes/inc-botblocker-wp-abilities.php:987
msgid "Stored result text, truncated to 80 characters because it may contain a PTR."
msgstr "Saklanan sonuç metni, PTR içerebileceği için 80 karaktere kısaltılmıştır."

#: includes/inc-botblocker-wp-abilities.php:985
msgid "Referer, masked."
msgstr "Yönlendiren, maskelenmiş."

#: includes/inc-botblocker-wp-abilities.php:984
msgid "Stored page URL without a query string."
msgstr "Sorgu dizesi olmadan saklanan sayfa adresi."

#: includes/inc-botblocker-wp-abilities.php:983
msgid "HTTP method of the request."
msgstr "İsteğin HTTP yöntemi."

#: includes/inc-botblocker-wp-abilities.php:982
msgid "Detected device type."
msgstr "Algılanan cihaz türü."

#: includes/inc-botblocker-wp-abilities.php:981
msgid "Detected operating system."
msgstr "Algılanan işletim sistemi."

#: includes/inc-botblocker-wp-abilities.php:980
msgid "Detected browser family."
msgstr "Algılanan tarayıcı ailesi."

#: includes/inc-botblocker-wp-abilities.php:979
msgid "Autonomous system name."
msgstr "Otonom sistem adı."

#: includes/inc-botblocker-wp-abilities.php:976
msgid "ISO 8601 event timestamp."
msgstr "ISO 8601 olay zaman damgası."

#: includes/inc-botblocker-wp-abilities.php:974
msgid "Visitor address, masked."
msgstr "Ziyaretçi adresi, maskelenmiş."

#: includes/inc-botblocker-wp-abilities.php:964
msgid "Event payload; keys depend on event_key."
