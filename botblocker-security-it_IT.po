msgstr "botblocker/get-data-integrity - file di runtime con dimensione, mtime, hash facoltativi, file mancanti ed extra."

#: admin/templates/integrations/wp-abilities.php:96
msgid "botblocker/get-db-health — table presence, size and approximate row counts."
msgstr "botblocker/get-db-health - presenza delle tabelle, dimensione e conteggi approssimativi disponi in riga."

#: admin/templates/integrations/wp-abilities.php:108
msgid "botblocker/get-decision-trace — explains the last stored decision for an IP address or a client id (cid)."
msgstr "botblocker/get-decision-trace - spiega la decisione memorizzata durare per un indirizzo IP o un client ID (cid)."

