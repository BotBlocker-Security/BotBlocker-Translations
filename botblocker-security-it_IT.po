msgstr "Utenti che possono modificare pagine create da altre persone. Di solito editor e amministratori."

#: addons/bbcs-sessions/views/settings.php:21
msgid "Users who can edit posts after they are published. Authors and editors usually have it; contributors do not."
msgstr "Utenti che possono modificare gli articoli dopo la pubblicazione. Di solito la possiedono autori ed editor; i collaboratori no."

#: addons/bbcs-sessions/views/settings.php:20
