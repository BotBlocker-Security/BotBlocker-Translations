#: includes/inc-botblocker-wp-abilities-diagnostics.php:1113
msgid "A cookie value is required."
msgstr "кукі-файл значэнне - гэта абавязковы, патрабаваны."

#: addons/bbcs-security-headers/inc/class-bbcs-security-headers-abilities.php:211
msgid "A CSP domain must contain a host."
msgstr "CSP-дамен павінен змяшчаць хост."

#: addons/bbcs-forced-inclusions/inc/class-file-classifier.php:85
msgid "A custom install script, or a host provisioning tool."
msgstr "Скрыпт адвольны, карыстальніцкі, уласны усталяваць, або, ці хост, вузел інструмент для прадастаўлення."

#: addons/bbcs-forced-inclusions/inc/class-file-classifier.php:73
msgid "A developer or debugging plugin."
