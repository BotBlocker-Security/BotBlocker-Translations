msgid "botblocker/remove-edge-trust — removes one auto-trust entry by mask and audits it. Requires confirm \"REMOVE\"."
msgstr "botblocker/remove-edge-trust - mask üzrə bir avtomatik etimad qeydini silir və onu audit edir. Təsdiq üçün \"REMOVE\" tələb olunur."

#: admin/templates/integrations/wp-abilities.php:155
msgid "botblocker/reset-ptr-cache — deletes cached reverse-DNS results and rotates the plugin cache generation. Requires confirm \"RESET\"."
msgstr "botblocker/reset-ptr-cache - keşlənmiş reverse-DNS nəticələrini silir və plagin keş nəslini dəyişdirir. Təsdiq üçün \"RESET\" tələb olunur."

#: admin/templates/integrations/wp-abilities.php:154
msgid "botblocker/reset-rate-limit — clears the individual and subnet buckets for an IP. Requires confirm \"RESET\"."
msgstr "botblocker/reset-rate-limit - bir IP üçün fərdi və alt şəbəkə bucket-lərini təmizləyir. \"RESET\" təsdiqi tələb olunur."

