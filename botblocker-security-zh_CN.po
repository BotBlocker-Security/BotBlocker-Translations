msgid "1 when the row was deleted; 0 on dry run."
msgstr "删除行时为 1；试运行时为 0。"

#: includes/inc-botblocker-wp-abilities.php:507
msgid "Confirmation token; must be DELETE."
msgstr ""

#: includes/inc-botblocker-wp-abilities.php:506
