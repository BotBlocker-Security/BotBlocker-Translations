msgstr "请求的保护状态。"

#: includes/inc-botblocker-wp-abilities.php:541
msgid "ENABLE when enabled is true; DISABLE when enabled is false."
msgstr "当 enabled 为 true 时，取值为 启用；当 enabled 为 false 时，取值为 停用。"

