msgstr "True wanneer de vertrouwensmaps zijn geladen; false wanneer include_map false is en maps leeg is."

#: includes/inc-botblocker-wp-abilities-diagnostics.php:2575
msgid "Trust maps; every list is empty when include_map is false."
msgstr "Vertrouwensmaps; elke lijst is leeg wanneer include_map false is."

#: includes/inc-botblocker-wp-abilities-diagnostics.php:2571
