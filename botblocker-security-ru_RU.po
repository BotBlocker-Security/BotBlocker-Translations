msgid "Multiplier applied to block RPM for subnet threshold. Higher = more tolerant. Default: 3."
msgstr "Множитель, применяемый к RPM блокировок для порога подсети. Чем выше значение, тем терпимее настройка. По умолчанию: 3."

#: admin/templates/settings/rate-limiting.php:163
#: includes/data/class-botblocker-snav.php:232
msgid "Subnet Multiplier"
msgstr "Множитель подсети"

#: admin/templates/settings/rate-limiting.php:155
msgid "Aggregate RPM across the subnet. High subnet pressure dynamically lowers per-IP thresholds to catch distributed proxy attacks."
msgstr "Агрегировать RPM по подсети. Высокая нагрузка на подсеть динамически снижает пороги для IP для выявления распределённых прокси-атак."

#: admin/templates/settings/rate-limiting.php:153
#: admin/templates/settings/rate-limiting.php:155
#: includes/data/class-botblocker-snav.php:229
#: includes/data/class-botblocker-snav.php:231
