msgstr "Целевое время ожидания после ограничения; текущее значение, если поле было пропущено."

#: includes/inc-botblocker-wp-abilities.php:623
msgid "CAPTCHA mode id before the call."
msgstr "id режима CAPTCHA до вызова."

#: includes/inc-botblocker-wp-abilities.php:621
msgid "Resolved CAPTCHA mode id after the call."
msgstr "Определённый id режима CAPTCHA после вызова."

#: includes/inc-botblocker-wp-abilities.php:613
msgid "Confirmation token; must be CAPTCHA."
msgstr "Токен подтверждения; должен быть CAPTCHA."

#: includes/inc-botblocker-wp-abilities.php:611
