msgstr "Агрегация подсетей"

#: admin/templates/settings/rate-limiting.php:143
msgid "min"
msgstr "мин"

#: admin/templates/settings/rate-limiting.php:142
msgid "Sliding window size in minutes. RPM = total hits in window / window minutes. Default: 5."
msgstr "Размер скользящего окна в минутах. RPM = общее число запросов за окно / длительность окна в минутах. По умолчанию: 5."

#: admin/templates/settings/rate-limiting.php:141
#: includes/data/class-botblocker-snav.php:225
msgid "Window"
msgstr "Окно"

#: admin/templates/settings/rate-limiting.php:132
