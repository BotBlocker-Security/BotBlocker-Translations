#: includes/viewmodels/class-settings-viewmodel.php:246
msgid "Temporary lockdown during an attack."
msgstr "Временный режим блокировки во время атаки."

#: includes/viewmodels/class-settings-viewmodel.php:245
msgid "Maximum detection for hardened sites."
msgstr "Максимальный уровень обнаружения для защищённых сайтов."

#: includes/viewmodels/class-settings-viewmodel.php:244
msgid "Strong rules for REST and automation."
msgstr "Жёсткие правила для REST и автоматизации."

#: includes/viewmodels/class-settings-viewmodel.php:243
msgid "Strict ruleset for sites under attack."
msgstr "Строгий набор правил для сайтов под атакой."

#: includes/viewmodels/class-settings-viewmodel.php:242
msgid "Extra checks without ad-blocker friction."
msgstr "Дополнительные проверки без конфликтов с блокировщиками рекламы."

#: includes/viewmodels/class-settings-viewmodel.php:237
msgid "Emergency preset"
msgstr "Аварийный пресет"

#: includes/viewmodels/class-settings-viewmodel.php:236
