msgid "Rows aggregated under this key."
msgstr "Wiersze zagregowane pod tym kluczem."

#: includes/inc-botblocker-wp-abilities-extended.php:452
msgid "Rows to return; values outside 1..100 are clamped."
msgstr "Liczba wierszy do zwrócenia; wartości spoza zakresu 1..100 są ograniczane."

#: includes/inc-botblocker-wp-abilities-extended.php:395
#: includes/inc-botblocker-wp-abilities-extended.php:494
#: includes/inc-botblocker-wp-abilities-extended.php:524
