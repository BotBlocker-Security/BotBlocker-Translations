#: includes/inc-botblocker-wp-abilities.php:2123
msgid "A rule id is required."
msgstr "נדרש מזהה כלל."

#: addons/bbcs-forced-inclusions/views/settings.php:55
msgid "A single file in wp-content that replaces one built-in part of WordPress."
msgstr "קובץ יחיד בתיקיית wp-content שמחליף חלק מובנה אחד של וורדפרס."

#: addons/bbcs-forced-inclusions/views/settings.php:134
msgid "a single file with a name WordPress recognises, such as object-cache.php. It replaces one built-in part of WordPress, for example caching or the \"site is down for maintenance\" page."
msgstr "קובץ יחיד עם שם שוורדפרס מזהה, כמו object-cache.php. הוא מחליף חלק מובנה אחד של וורדפרס, למשל מטמון או עמוד „האתר מושבת לצורך תחזוקה”."

#: admin/templates/integrations/mu.php:21
msgid "A small loader file is installed into wp-content/mu-plugins and pulls the main plugin code on every request."
msgstr "קובץ טוען קטן מותקן בתיקיית wp-content/mu-plugins ומושך את קוד התוסף הראשי בכל בקשה."

#: includes/inc-botblocker-wp-abilities.php:923
#: includes/inc-botblocker-wp-abilities.php:927
