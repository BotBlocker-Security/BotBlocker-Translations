#: addons/bbcs-page-cache/views/settings.php:189
msgid "A visitor carrying a cookie whose name contains one of these strings always gets a live page. Login, password-post and commenter cookies are always excluded."
msgstr "מבקר שנושא קוקי ששמו מכיל אחת מהמחרוזות האלה תמיד מקבל עמוד חי. קוקיז של התחברות, של פרסום עם סיסמה ושל מגיבים תמיד מוחרגים."

#: addons/bbcs-pusher/views/settings.php:25
msgid "A weekly digest with request, block and bot statistics is delivered on a schedule. The add-on never runs on visitor requests."
msgstr "תקציר שבועי עם סטטיסטיקות בקשות, בלוקים ובוטים נשלח לפי לוח זמנים. התוסף הנוסף לעולם לא רץ על בקשות מבקרים."

#: addons/bbcs-telegram/views/settings.php:26
