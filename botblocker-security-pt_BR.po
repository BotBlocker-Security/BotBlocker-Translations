msgid "botblocker/reset-rate-limit — clears the individual and subnet buckets for an IP. Requires confirm \"RESET\"."
msgstr "botblocker/reset-rate-limit - limpa os buckets individuais e de sub-rede de um IP. Requer confirmação \"Redefinir\"."

